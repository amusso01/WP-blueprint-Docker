# Compose uses this to name the stack and volumes (e.g. acme_db_data).
COMPOSE_PROJECT_NAME=my-project

# Hostname: https://local.PROJECT_NAME.dev
PROJECT_NAME=my-project

# TablePlus / other GUI clients on the Mac. Change if two sites run at once.
MYSQL_PORT=3306

MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=root

# WordPress DB table prefix (must end with _). Set uniquely per project.
WORDPRESS_TABLE_PREFIX=wp_
